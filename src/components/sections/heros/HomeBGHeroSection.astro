---
import { Container } from '@components/odyssey-theme';
---

<Container>
	<section class="hero-section__section">
		<div class="hero-section__text">
				<h1>Bill Gehring</h1>
				<p> Professor Emeritus of Psychology<br>
					Arthur F. Thurnau Professor Emeritus<br>
					University of Michigan</p>
				<p class="hero-section__blurb">Cognitive scientist and educator with 30+ years fostering academic success for diverse learners. Extensive experience in academic innovation, student mentoring, and evidence-based learning strategies. Technological expertise in generative AI and learning analytics. </p>
				<nav class="hero-section__links" aria-label="Site sections">
					<a href="/research">Research</a>
					<a href="/teaching">Teaching</a>
					<a href="/files/BillGehring_CV_Latest.pdf">CV</a>
					<a href="/contact">Contact</a>
				</nav>
		</div>
		<div class="hero-section__image">
				<picture>
					<img
						src="/assets/images/bg1_640x800.png"
						alt="Bill Gehring"
						id="home-hero-image"
					/>
				</picture>
		</div>
	</section>
</Container>

<style>
	.hero-section__section {
		margin: var(--section-margin) auto;
		min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 1rem;
	}
	.hero-section__text {
		justify-self: center;
		max-width: 30rem;
	}
	.hero-section__blurb {
		margin-top: 1.5rem;
		line-height: 1.5;
	}
	.hero-section__links {
		margin-top: 2rem;
		font-size: var(--font-size-sm);
	}
	.hero-section__links a {
		color: var(--theme-on-bg);
		text-decoration: none;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.hero-section__links a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.hero-section__links a + a::before {
		content: "·";
		margin: 0 0.9rem;
		color: #aaa;
		font-weight: 400;
		text-decoration: none;
	}
	.hero-section__image {
		display: flex;
	}
	.hero-section__image img {
		width: 100%;
		height: 100%;
		max-height: 80vh;
		/* object-fit: cover; */
		object-fit: contain;
		border-radius: var(--theme-shape-radius);
		/* added as per chatGPT */
		min-width: 250px;
		min-height: 140px;
	}
	@media (max-width: 768px) {
		.hero-section__section {
			grid-template-columns: 1fr;
		}
	}
</style>